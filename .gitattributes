# Normalize line endings: LF in the repository, native on checkout.
* text=auto

# Scripts must stay executable/consistent regardless of the platform.
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files must not be touched by Git.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
